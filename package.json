{
  "name": "axiom-launcher",
  "productName": "Axiom",
  "version": "1.1.0",
  "description": "Axiom, a custom Minecraft launcher",
  "author": "axiomdev",
  "license": "MIT",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always",
    "icons": "python3 scripts/make-icons.py",
    "setup": "cargo build --release --manifest-path installer/Cargo.toml"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "skinview3d": "3.4.2"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.axiomdev.axiom",
    "productName": "Axiom",
    "copyright": "Copyright \u00a9 2026 axiomdev",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**/{README,CHANGELOG,readme,changelog}*",
      "!**/node_modules/**/*.d.ts"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Axiom",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "artifactName": "Axiom-Full-Setup.${ext}",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Axiom"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "axiomdev",
        "repo": "axiom-launcher",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US",
      "nl"
    ],
    "compression": "maximum"
  }
}
